# Copy to .env.product.local at workspace root. Never place it in prototype-v2.
PRODUCT_MODE=production
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_PUBLISHABLE_KEY=YOUR_PUBLIC_PUBLISHABLE_KEY
GOOGLE_CLIENT_ID=YOUR_GOOGLE_CLIENT_ID
GOOGLE_CLIENT_SECRET=YOUR_SERVER_ONLY_GOOGLE_CLIENT_SECRET
GOOGLE_REDIRECT_URI=https://YOUR_DOMAIN/api/connections/google/callback
GOOGLE_TOKEN_ENCRYPTION_KEY=YOUR_32_BYTE_BASE64_SERVER_ONLY_KEY
